<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vendored copy of microsoft/ProjFS-Managed-API (MIT). Kept in-tree so the
       provider builds offline and the ABI is pinned to this repo revision. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Microsoft.Windows.ProjFS</RootNamespace>
    <AssemblyName>ProjectedFSLib.Managed</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsAotCompatible>false</IsAotCompatible>
    <NoWarn>$(NoWarn);CA1416;CS1591</NoWarn>
  </PropertyGroup>

</Project>
