{
  "name": "dsh-winstage-sandbox",
  "version": "1.0.0",
  "description": "DeepSeek Harness (DSH) plugin: WinStage staging–candidate–selective-commit sandbox for Windows. AI changes land in a staging tree (files + registry); a review panel shows the diff and only approved changes are written to the real workspace.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gygygfg/dsh-winstage-sandbox.git"
  },
  "homepage": "https://github.com/gygygfg/dsh-winstage-sandbox",
  "bugs": {
    "url": "https://github.com/gygygfg/dsh-winstage-sandbox/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sandbox",
    "windows",
    "staging",
    "approval",
    "agent"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./host-plugin": "./dist/index.mjs",
    "./fs": "./dist/fs-entry.mjs",
    "./shell": "./dist/shell-entry.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "meta": {
    "title": "WinStage Sandbox",
    "description": "Staging–candidate–selective-commit sandbox (Windows restricted token + ACL + Job Object). Toggleable in Settings; when off, the platform's original shell and file tools are left in place."
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node tools/build-plugin.ts",
    "prepack": "node tools/build-plugin.ts",
    "prepare": "node tools/build-plugin.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-commands": "0.0.1-rc.1",
    "@deepseek-ai/dsh-fs": "0.0.1-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.0.1-rc.1",
    "@deepseek-ai/dsh-fs-sandbox": "0.0.1-rc.1",
    "@deepseek-ai/dsh-pwsh-sandbox": "0.0.1-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.0.1-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "0.0.1-rc.1",
    "@deepseek-ai/dsh-shell": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-storage": "0.0.1-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.0.1-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.0.1-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-web": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/",
    "plugin/",
    "dsh-plugin/",
    "src/",
    "shim/src/",
    "shim/include/",
    "shim/injector/",
    "shim/probe/",
    "patches/",
    "tools/build-shim.ts",
    "tools/pe-exports.ts",
    "tools/fetch-toolchain.ts",
    "tools/sandbox-audit.ts",
    "tools/dsh-patches.ts",
    "tools/uninstall-restore.ts",
    "tools/plugin-remove-cleanup.ts",
    "README.md",
    "LICENSE",
    "PUBLISHING.md"
  ]
}
