{
  "name": "dsh-sandbox-linux",
  "version": "0.2.0",
  "private": true,
  "description": "Standalone Linux sandbox plugin for dsh: bubblewrap/Landlock confinement plus the dry-run/commit control plane (overlay staging, CAS publish, policy evaluation)",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-sandbox": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-approval": "*",
    "@deepseek-ai/dsh-bash-local": "*",
    "@deepseek-ai/dsh-bash-sandbox": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-fs-local": "*",
    "@deepseek-ai/dsh-sandbox-policy": "*",
    "@deepseek-ai/dsh-shell": "*",
    "@deepseek-ai/dsh-storage": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-subprocess-local": "*",
    "@deepseek-ai/dsh-util-values": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/node-addon-system": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
