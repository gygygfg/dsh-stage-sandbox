{
  "name": "dsh-sandbox-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone cross-platform sandbox plugin for dsh: a PAL-backed provider that registers ctx.sandbox",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-sandbox": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sandbox-pal": "*",
    "@deepseek-ai/dsh-sandbox-windows-acl": "*",
    "@deepseek-ai/dsh-util-values": "*",
    "@deepseek-ai/node-addon-system": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
